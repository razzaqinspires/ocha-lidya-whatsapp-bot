# Rental dashboard API uses a separate loopback port from Nexora Code Lab.
OCHA_RENTAL_API_HOST=127.0.0.1
OCHA_RENTAL_API_PORT=8788
OCHA_RENTAL_API_TUNNEL=0
CLOUDFLARED_BIN=cloudflared

# Operator ZIP includes the local private runtime under ignored .private/ocha-private-runtime/.
# A clean public Git clone intentionally lacks it and runs public compatibility adapters.
OCHA_PRIVATE_RUNTIME_REQUIRED=0
# Optional external package path; leave blank to load the bundled local private runtime.
OCHA_PRIVATE_RUNTIME_PATH=

# The Artificial Consciousness Component remains a separate base project.
# When both base folders are siblings, this uses the supplied local NADI source.
# OCHA_NADI_SOURCE_DIR=../artificial-consciousness-component
# Its remote fallback remains pinned to the reviewed immutable commit in src/runtime/nadi-component.js.
