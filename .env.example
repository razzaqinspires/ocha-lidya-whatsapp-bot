# Optional AI provider credentials. Add keys with .apikey for secure vault storage.
GROQ_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
OPENAI_API_KEY=

# Optional GitHub integration for Auto Git Sync.
GITHUB_PAT=

# Optional YouTube media tool overrides (non-secret). Install yt-dlp + FFmpeg separately.
YT_DLP_BIN=yt-dlp
FFMPEG_LOCATION=
YOUTUBE_MAX_DOWNLOAD_MB=48
YOUTUBE_MAX_DURATION_SECONDS=1800
YOUTUBE_SEARCH_RESULTS=5


# Encrypted, per-user conversation archive (roo/*).
# Keep this directory private and back up it together with its master key.
OCHA_ROO_ROOT=data/roo
# Optional 32-byte master key as 64 hexadecimal chars. If empty, the app
# creates data/roo/.master-key on first use with owner-only file permissions.
OCHA_ROO_MASTER_KEY=
