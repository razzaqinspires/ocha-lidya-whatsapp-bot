# OCHA LIDYA — SECRETS ONLY
# Non-secret runtime settings are maintained in config/runtime.json.
# Never commit real credentials.

# AI provider credentials
GROQ_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
OPENAI_API_KEY=

# One fine-grained GitHub PAT with Contents read/write access to BOTH
# razzaqinspires/ocha-lidya-whatsapp-bot and
# razzaqinspires/artificial-consciousness-component.
GITHUB_PAT=

# Optional external key for Ocha Roo private-vault encryption.
# Leave empty for the default locally-generated data/roo/.master-key.
OCHA_ROO_MASTER_KEY=

# Optional Bearer token for a remote NADI HTTP API. Keep secret; do not put it in config/runtime.json.
OCHA_NADI_API_TOKEN=

# ChatNivo account credentials used by owner-private export and optional final AI fallback.
CHATNIVO_EMAIL=
CHATNIVO_PASSWORD=

# BEGIN OCHA AUTO-DISCOVERED ENVIRONMENT VARIABLES
# Generated automatically by scripts/sync-env-example.js during npm start, npm run dev, and npm test.
# Do not place real credentials here. The scanner reads source code only; it never reads .env values.
# Source coverage: 10 application/secret names, 4 internal markers, 23 host/OS names.
# Host/OS names (inherited, not project .env settings): DYLD_LIBRARY_PATH, FORCE_COLOR, HOME, HOMEDRIVE, HOMEPATH, LANG, LC_ALL, LD_LIBRARY_PATH, NO_COLOR, npm_execpath, PATH, PYTHONHOME, PYTHONPATH, SSL_CERT_DIR, SSL_CERT_FILE, SYSTEMROOT, TEMP, TERM, TMP, TMPDIR, USERPROFILE, VIRTUAL_ENV, WINDIR.
# Ocha-managed markers (do not set manually): OCHA_BOOTSTRAP_HANDOFF_CONSUMED, OCHA_HANDOFF_FROM_PID, OCHA_HOST_BOOTSTRAP_FORCE, OCHA_HOST_PREFLIGHT_COMPLETED.
# INTERNAL MARKER: discovered in src/runtime/bootstrap-agent.js; Ocha-managed, do not set manually.
# OCHA_BOOTSTRAP_HANDOFF_CONSUMED=
# INTERNAL MARKER: discovered in src/runtime/bootstrap-agent.js; Ocha-managed, do not set manually.
# OCHA_HANDOFF_FROM_PID=
# INTERNAL MARKER: discovered in src/runtime/bootstrap-agent.js; Ocha-managed, do not set manually.
# OCHA_HOST_BOOTSTRAP_FORCE=
# INTERNAL MARKER: discovered in src/index.js; Ocha-managed, do not set manually.
# OCHA_HOST_PREFLIGHT_COMPLETED=
# REVIEW: discovered in scripts/bootstrap/llama-runtime.js; confirm purpose and safe default before enabling.
# OCHA_LLAMA_BOOTSTRAP_DRY_RUN=
# END OCHA AUTO-DISCOVERED ENVIRONMENT VARIABLES
