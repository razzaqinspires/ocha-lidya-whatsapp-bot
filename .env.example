# OCHA LIDYA — ENVIRONMENT TEMPLATE
# Copy to .env. Values in this file are examples/defaults only; never commit real credentials.
# Ocha loads .env through dotenv at application startup.

# -----------------------------------------------------------------------------
# AI provider credentials
# Multiple keys may be separated with commas or semicolons.
# -----------------------------------------------------------------------------
GROQ_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
OPENAI_API_KEY=

# GitHub auto-push credentials: use separate fine-grained tokens and scope each
# token to Contents read/write for its matching repository only.
GITHUB_PAT=
AC_GITHUB_PAT=
# 32-byte key encoded as exactly 64 hexadecimal characters.
# Required only when encrypted user-vault data uses the external master-key mode.
OCHA_ROO_MASTER_KEY=

# Optional Bearer token when connecting to a remote NADI HTTP API.
OCHA_NADI_API_TOKEN=

# -----------------------------------------------------------------------------
# NADI component loader and local sidecar
# Defaults are pinned to the reviewed external component revision.
# -----------------------------------------------------------------------------
OCHA_NADI_REPO_URL=https://github.com/razzaqinspires/artificial-consciousness-component
OCHA_NADI_REF=16c2fa6e1b500745f260bcf091284a6e18726883
OCHA_NADI_HOME=
OCHA_NADI_SOURCE_DIR=.private/artificial-consciousness-component
OCHA_NADI_SHA256=
OCHA_NADI_UPDATE=0
OCHA_NADI_BASE_URL=
OCHA_NADI_PORT=18765
OCHA_NADI_DATA_DIR=
OCHA_AC_HEARTBEAT_MS=1000
OCHA_PYTHON_BIN=

# -----------------------------------------------------------------------------
# Ocha storage and runtime paths
# Empty path overrides use the defaults documented in docs/ENVIRONMENT_VARIABLES.md.
# -----------------------------------------------------------------------------
OCHA_KERNEL_DASHBOARD_DIR=data/kernel
OCHA_KERNEL_TELEMETRY_FILE=data/kernel/telemetry.json
OCHA_PROJECT_LIBRARY_ROOT=
OCHA_ROO_ROOT=data/roo

# -----------------------------------------------------------------------------
# Private runtime package
# -----------------------------------------------------------------------------
OCHA_PRIVATE_RUNTIME_REQUIRED=0
OCHA_PRIVATE_RUNTIME_PATH=

# -----------------------------------------------------------------------------
# Rental HTTP API
# -----------------------------------------------------------------------------
OCHA_RENTAL_API_HOST=127.0.0.1
OCHA_RENTAL_API_PORT=8788
OCHA_RENTAL_API_TUNNEL=0
CLOUDFLARED_BIN=cloudflared

# -----------------------------------------------------------------------------
# Developer / host tooling
# -----------------------------------------------------------------------------
OCHA_PRETTIER_BIN=npx
NEXORA_BOOTSTRAP_DRY_RUN=0

# -----------------------------------------------------------------------------
# Internal runtime markers — Ocha sets/clears these automatically.
# Do not set these manually in .env.
# -----------------------------------------------------------------------------
# OCHA_HOST_PREFLIGHT_COMPLETED=1
# OCHA_HANDOFF_FROM_PID=
# OCHA_BOOTSTRAP_HANDOFF_CONSUMED=0
# OCHA_HOST_BOOTSTRAP_FORCE=0

# Host/terminal variables such as PATH, HOME, TMPDIR, TERM, NO_COLOR, and
# FORCE_COLOR are inherited from the operating system or shell; they are not
# Ocha-specific application settings and normally should not be copied here.

# BEGIN OCHA AUTO-DISCOVERED ENVIRONMENT VARIABLES
# Generated automatically by scripts/sync-env-example.js during npm start, npm run dev, and npm test.
# Do not place real credentials here. The scanner reads source code only; it never reads .env values.
# Source coverage: 31 application/secret names, 4 internal markers, 23 host/OS names.
# Host/OS names (inherited, not project .env settings): DYLD_LIBRARY_PATH, FORCE_COLOR, HOME, HOMEDRIVE, HOMEPATH, LANG, LC_ALL, LD_LIBRARY_PATH, NO_COLOR, npm_execpath, PATH, PYTHONHOME, PYTHONPATH, SSL_CERT_DIR, SSL_CERT_FILE, SYSTEMROOT, TEMP, TERM, TMP, TMPDIR, USERPROFILE, VIRTUAL_ENV, WINDIR.
# Ocha-managed markers (do not set manually): OCHA_BOOTSTRAP_HANDOFF_CONSUMED, OCHA_HANDOFF_FROM_PID, OCHA_HOST_BOOTSTRAP_FORCE, OCHA_HOST_PREFLIGHT_COMPLETED.
# No newly discovered production keys require review.
# END OCHA AUTO-DISCOVERED ENVIRONMENT VARIABLES
